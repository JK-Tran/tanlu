rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Ảnh/video bài viết: feeds/{teacherId}/{feedId}/{fileName}
    match /feeds/{teacherId}/{feedId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == teacherId;
    }

    // Legacy — giữ tới khi xóa hết file posts/ trên Storage
    match /posts/{teacherId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == teacherId;
    }

    // File có sẵn (avatar mẫu, asset admin upload) — chỉ đọc
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
